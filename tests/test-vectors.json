{
  "version": 1,
  "_comment": "Legacy cases were written against tag wi-exclude. The vector test applies top-level defaultTags as options.tags to every case that has no options.tags (options like attribute/markers are kept). Cases marked useBuiltinDefault:true get NO defaultTags and exercise the extension's true built-in default tag (st-loreveil).",
  "defaultTags": ["wi-exclude"],
  "cases": [
    { "name": "plain text untouched", "input": "Mira walks in.", "blank": [] },
    { "name": "basic tag", "input": "Scene. <wi-exclude>Off-scene: Mira</wi-exclude> Done.", "blank": ["<wi-exclude>Off-scene: Mira</wi-exclude>"] },
    { "name": "tag name case-insensitive", "input": "<WI-Exclude>Mira</wi-EXCLUDE> x", "blank": ["<WI-Exclude>Mira</wi-EXCLUDE>"] },
    { "name": "closing tag with trailing space", "input": "<wi-exclude>Mira</wi-exclude > x", "blank": ["<wi-exclude>Mira</wi-exclude >"] },
    { "name": "markers", "input": "a !--WI_EXCLUDE_START--!Mira!--WI_EXCLUDE_END--! b", "blank": ["!--WI_EXCLUDE_START--!Mira!--WI_EXCLUDE_END--!"] },
    { "name": "markers are case-sensitive", "input": "a !--wi_exclude_start--!Mira!--wi_exclude_end--! b", "blank": [] },
    { "name": "unclosed marker runs to end", "input": "a !--WI_EXCLUDE_START--!Mira and Holt", "blank": ["!--WI_EXCLUDE_START--!Mira and Holt"] },
    { "name": "nested markers", "input": "x !--WI_EXCLUDE_START--!a!--WI_EXCLUDE_START--!b!--WI_EXCLUDE_END--!c!--WI_EXCLUDE_END--! y", "blank": ["!--WI_EXCLUDE_START--!a!--WI_EXCLUDE_START--!b!--WI_EXCLUDE_END--!c!--WI_EXCLUDE_END--!"] },
    { "name": "stray end marker ignored", "input": "x !--WI_EXCLUDE_END--! Mira", "blank": [] },
    { "name": "attribute form", "input": "<div class=\"tracker\" wi-exclude>Location: Anchor</div> after", "blank": ["<div class=\"tracker\" wi-exclude>Location: Anchor</div>"] },
    { "name": "attribute with value", "input": "<div wi-exclude=\"true\">Mira</div> z", "blank": ["<div wi-exclude=\"true\">Mira</div>"] },
    { "name": "attribute name case-insensitive", "input": "<p WI-EXCLUDE>Mira</p> z", "blank": ["<p WI-EXCLUDE>Mira</p>"] },
    { "name": "attribute nested same-name elements", "input": "<div wi-exclude><div>Mira</div>Holt</div> after", "blank": ["<div wi-exclude><div>Mira</div>Holt</div>"] },
    { "name": "attribute value is not exclusion", "input": "<div class=\"wi-exclude\">Mira</div>", "blank": [] },
    { "name": "quoted > inside attribute", "input": "<div title=\"a>b\" wi-exclude>Mira</div> ok", "blank": ["<div title=\"a>b\" wi-exclude>Mira</div>"] },
    { "name": "self-closing excluded element", "input": "before <span wi-exclude/> Mira", "blank": ["<span wi-exclude/>"] },
    { "name": "self-closing excluded tag name", "input": "before <wi-exclude/> Mira", "blank": ["<wi-exclude/>"] },
    { "name": "void element", "input": "<img src=\"x.png\" wi-exclude> Mira", "blank": ["<img src=\"x.png\" wi-exclude>"] },
    { "name": "unclosed element runs to end", "input": "ok <wi-exclude>Mira forever", "blank": ["<wi-exclude>Mira forever"] },
    { "name": "unterminated excluded opener runs to end", "input": "ok <div wi-exclude title=\"oops>Mira", "blank": ["<div wi-exclude title=\"oops>Mira"] },
    { "name": "comment makes tags inert", "input": "<!-- <wi-exclude> -->Mira", "blank": [] },
    { "name": "comment inside excluded element is skipped", "input": "<div wi-exclude><!-- </div> -->Mira</div> x", "blank": ["<div wi-exclude><!-- </div> -->Mira</div>"] },
    { "name": "tags inside marker region are inert", "input": "!--WI_EXCLUDE_START--!<wi-exclude>!--WI_EXCLUDE_END--!Mira</wi-exclude>", "blank": ["!--WI_EXCLUDE_START--!<wi-exclude>!--WI_EXCLUDE_END--!"] },
    { "name": "whole message excluded becomes empty", "input": "<wi-exclude>Mira</wi-exclude>", "expectEmpty": true },
    { "name": "whole message excluded with surrounding whitespace", "input": "  <wi-exclude>x</wi-exclude>\n", "expectEmpty": true },
    { "name": "attribute option off", "input": "<div wi-exclude>Mira</div>", "options": { "attribute": false }, "blank": [] },
    { "name": "markers option off", "input": "!--WI_EXCLUDE_START--!Mira!--WI_EXCLUDE_END--!", "options": { "markers": false }, "blank": [] },
    { "name": "custom tag replaces default", "input": "<lore-skip>Mira</lore-skip> <wi-exclude>Holt</wi-exclude>", "options": { "tags": ["lore-skip"] }, "blank": ["<lore-skip>Mira</lore-skip>"] },
    { "name": "custom tag markers", "input": "!--LORE_SKIP_START--!Mira!--LORE_SKIP_END--! end", "options": { "tags": ["lore-skip"] }, "blank": ["!--LORE_SKIP_START--!Mira!--LORE_SKIP_END--!"] },
    { "name": "custom tag attribute", "input": "<div lore-skip>Mira</div> end", "options": { "tags": ["lore-skip"] }, "blank": ["<div lore-skip>Mira</div>"] },
    { "name": "multiple tags", "input": "<ooc>Mira</ooc> and <wi-exclude>Holt</wi-exclude>!", "options": { "tags": ["wi-exclude", "ooc"] }, "blank": ["<ooc>Mira</ooc>", "<wi-exclude>Holt</wi-exclude>"] },
    { "name": "markers of different tags share depth", "input": "a !--OOC_START--!x!--WI_EXCLUDE_END--! b", "options": { "tags": ["wi-exclude", "ooc"] }, "blank": ["!--OOC_START--!x!--WI_EXCLUDE_END--!"] },
    { "name": "raw text element body is inert", "input": "<script>\"<wi-exclude>\"</script>Mira", "blank": [] },
    { "name": "lone less-than is not a tag", "input": "a < b and <wi-exclude>Mira</wi-exclude>", "blank": ["<wi-exclude>Mira</wi-exclude>"] },
    { "name": "unterminated quote in normal tag stops scan", "input": "<div title=\"unterminated <wi-exclude>Mira</wi-exclude>", "blank": [] },
    { "name": "other tags inside region", "input": "<wi-exclude><b>Mira</b></wi-exclude> x", "blank": ["<wi-exclude><b>Mira</b></wi-exclude>"] },
    { "name": "multiple regions", "input": "A <wi-exclude>1</wi-exclude> B <wi-exclude>2</wi-exclude> C", "blank": ["<wi-exclude>1</wi-exclude>", "<wi-exclude>2</wi-exclude>"] },
    { "name": "no word fusion across region", "input": "Mi<wi-exclude>x</wi-exclude>ra", "blank": ["<wi-exclude>x</wi-exclude>"] },
    { "name": "prototype-like tag names are not special", "input": "<constructor>Mira</constructor> <toString wi-exclude>Holt</toString>", "blank": ["<toString wi-exclude>Holt</toString>"] },
    { "name": "non-BMP characters keep length", "input": "😀<wi-exclude>😀Mira</wi-exclude>😀", "blank": ["<wi-exclude>😀Mira</wi-exclude>"] }
,
    { "name": "builtin default: element", "useBuiltinDefault": true, "input": "a <st-loreveil>Mira</st-loreveil> b", "blank": ["<st-loreveil>Mira</st-loreveil>"] },
    { "name": "builtin default: markers", "useBuiltinDefault": true, "input": "a !--ST_LOREVEIL_START--!Mira!--ST_LOREVEIL_END--! b", "blank": ["!--ST_LOREVEIL_START--!Mira!--ST_LOREVEIL_END--!"] },
    { "name": "builtin default: attribute", "useBuiltinDefault": true, "input": "<div st-loreveil>Mira</div> b", "blank": ["<div st-loreveil>Mira</div>"] },
    { "name": "builtin default: wi-exclude is not blanked", "useBuiltinDefault": true, "input": "<wi-exclude>Mira</wi-exclude> !--WI_EXCLUDE_START--!Holt!--WI_EXCLUDE_END--! <div wi-exclude>Ann</div>", "blank": [] }
  ],
  "normalize": [
    { "input": "wi-exclude", "tags": ["wi-exclude"], "invalid": [] },
    { "input": " WI-Exclude , ooc ", "tags": ["wi-exclude", "ooc"], "invalid": [] },
    { "input": "bad tag!, ok", "tags": ["ok"], "invalid": ["bad tag!"] },
    { "input": "", "tags": [], "invalid": [] },
    { "input": "a, A ,,", "tags": ["a"], "invalid": [] },
    { "input": "1abc, lore:skip", "tags": ["lore:skip"], "invalid": ["1abc"] }
  ],
  "markers": [
    { "tag": "wi-exclude", "start": "!--WI_EXCLUDE_START--!", "end": "!--WI_EXCLUDE_END--!" },
    { "tag": "lore:skip", "start": "!--LORE_SKIP_START--!", "end": "!--LORE_SKIP_END--!" },
    { "tag": "st-loreveil", "start": "!--ST_LOREVEIL_START--!", "end": "!--ST_LOREVEIL_END--!" },
    { "tag": "ooc", "start": "!--OOC_START--!", "end": "!--OOC_END--!" }
  ]
}
